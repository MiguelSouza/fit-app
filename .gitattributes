# Normalize all text files to LF in the repository and in the working tree,
# on every platform. Keeps checkouts consistent with .editorconfig
# (end_of_line = lf) even when a contributor has core.autocrlf=true.
* text=auto eol=lf

# Scripts that must keep their platform's line endings
*.sh    text eol=lf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# Lockfiles: text, but never show up in review diffs
pnpm-lock.yaml linguist-generated=true

# Binaries
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.jar   binary
*.keystore binary
