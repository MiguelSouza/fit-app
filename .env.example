# Modelo de ambiente do fit-app. Copie para `.env` e preencha:
#
#     cp .env.example .env
#
# `.env` está no `.gitignore` e nunca é commitado. Este arquivo não tem valor
# real nenhum: as chaves locais saem do `pnpm exec supabase status -o env`; as de
# staging e produção ficam no AWS Secrets Manager, em `sa-east-1`, e na Vercel —
# nunca aqui, nunca no chat, nunca em log.
#
# Boa parte das variáveis é de pacote que ainda não existe; cada bloco diz o card
# que vai usá-la. Enquanto o pacote não existir, a variável fica como documentação
# do que vai ser preciso.

# ----------------------------------------------------------------------------
# Supabase local (Docker) — vale para todo mundo
# ----------------------------------------------------------------------------
# Portas e chaves vêm do `supabase/config.toml`. Depois do `pnpm db:start`:
#   API/Auth/Storage  http://127.0.0.1:54321
#   Postgres          postgresql://postgres:postgres@127.0.0.1:54322/postgres
#   Studio            http://127.0.0.1:54323
#   E-mails de teste  http://127.0.0.1:54324 (Mailpit)
SUPABASE_URL=http://127.0.0.1:54321
# Chave pública (anon). Vem do `pnpm exec supabase status -o env`, como as duas
# de baixo: o `db:start` imprime só o par `Publishable`/`Secret`, que não usamos.
SUPABASE_ANON_KEY=
# Chave de serviço: ignora RLS. Só a API usa, nunca o painel nem o app.
SUPABASE_SERVICE_ROLE_KEY=
# Segredo com que o Supabase Auth assina o JWT; a API valida com ele (card F-08).
# Obrigatória: sem ela a API não sobe. O do stack local tem 55 caracteres e o de um
# projeto hospedado tem 40; menos de 32 é recusado.
SUPABASE_JWT_SECRET=

# ----------------------------------------------------------------------------
# API — apps/api (card F-05)
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=3333
# Postgres do Supabase. Local, a senha é `postgres` mesmo; em staging e produção
# a string inteira vem do Secrets Manager.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Origens que o painel usa, separadas por vírgula. As duas grafias do servidor de
# desenvolvimento são origens diferentes para o navegador, então as duas entram.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Fila de jobs (pg-boss). Usa o DATABASE_URL acima e cria o schema `pgboss` no
# mesmo banco (ADR 0009). `true` ou `false`; vazio liga em desenvolvimento e em
# produção e desliga em teste. Desligue quando o processo só precisa dos módulos
# de pé, sem Postgres atrás — é o que o `pnpm api:generate` faz.
JOBS_ENABLED=
# Bucket do Storage onde ficam os anexos do paciente (foto de refeição, exame).
SUPABASE_STORAGE_BUCKET=patient-attachments
# Volume do log: fatal, error, warn, info, debug, trace ou silent. Vazio usa o
# padrão do ambiente — `debug` em desenvolvimento, `info` em produção e
# `silent` em teste. Não muda o que é mascarado: nome, e-mail, telefone, token,
# notas e valores de check-in nunca saem, em nenhum nível.
LOG_LEVEL=

# Agregador de wearables, atrás da porta `WearableAggregator` (ADR 0003). O
# fornecedor é escolhido no card OP-04, então os nomes aqui são neutros.
WEARABLE_AGGREGATOR_BASE_URL=
WEARABLE_AGGREGATOR_API_KEY=
WEARABLE_AGGREGATOR_WEBHOOK_SECRET=

# Fornecedor de IA, atrás de porta própria. Só recebe dado de paciente com
# consentimento `ai_processing` vigente, e anonimizado (CLAUDE.md).
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=

# Observabilidade dos prompts (Langfuse). Anonimize antes de enviar.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Erros (Sentry, ADR 0013). Vazio desliga o envio: o erro fica no log e mais nada,
# que é o que uma máquina de desenvolvimento e o CI querem. Preenchido, as outras
# duas passam a valer.
SENTRY_DSN=
# Como o ambiente aparece no Sentry. Vazio usa o NODE_ENV; existe porque os dois
# não são a mesma pergunta: a task de staging roda com NODE_ENV=production.
SENTRY_ENVIRONMENT=
# Qual versão está mandando: a tag da imagem ou o sha do commit. Obrigatória
# quando há DSN — evento que não diz a versão não responde se o bug ainda está no ar.
SENTRY_RELEASE=

# ----------------------------------------------------------------------------
# Painel do profissional — apps/web (card F-13)
# ----------------------------------------------------------------------------
# `NEXT_PUBLIC_*` vai para o navegador. Nunca ponha chave de serviço aqui.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3333
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry do painel (ADR 0013). O DSN vai para o navegador, e por isso é público:
# ele só permite mandar evento para o projeto, nunca ler. Vazio desliga o envio.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Vazio na Vercel usa o sha do commit do deploy (VERCEL_GIT_COMMIT_SHA).
NEXT_PUBLIC_SENTRY_RELEASE=

# ----------------------------------------------------------------------------
# App do paciente — apps/mobile (card F-14)
# ----------------------------------------------------------------------------
# Flutter não lê `.env`: estes valores entram por `--dart-define`. Ficam aqui
# para o passo a passo do README poder montar a linha de comando.
#   flutter run --dart-define=API_URL=$FLUTTER_API_URL ...
# No emulador Android, `127.0.0.1` é o próprio emulador: use `10.0.2.2`.
# Vai na mesma linha de comando, e não é variável de ambiente nenhuma:
# `--dart-define=APP_ENV=local` (ou `staging`, ou `production`). Sem ele o app
# assume `local`, e toda build que não é produção mostra o selo do ambiente.
FLUTTER_API_URL=http://127.0.0.1:3333
FLUTTER_SUPABASE_URL=http://127.0.0.1:54321
FLUTTER_SUPABASE_ANON_KEY=
# Sentry do app (ADR 0013), também por --dart-define: SENTRY_DSN e SENTRY_RELEASE.
# Sem o DSN o app não manda nada. O ambiente vem do APP_ENV, que já está acima.
FLUTTER_SENTRY_DSN=
FLUTTER_SENTRY_RELEASE=
