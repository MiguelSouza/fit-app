{
  "openapi": "3.0.0",
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "HealthController_get_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Estado do processo e das suas dependências",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Health"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "description": "Responde o perfil, o tipo de profissional e as organizações de quem está chamando. Quem entrou no Supabase Auth e ainda não concluiu o primeiro acesso não tem perfil, e a resposta é 404 — é o que leva o painel à tela de primeiro acesso.",
        "operationId": "MeController_get_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Identidade de quem fez a chamada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Quem chamou não tem perfil: `identity.profile.not_found`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado. É o envelope de erro de toda a API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Identidade de quem fez a chamada",
        "tags": [
          "Me"
        ]
      }
    },
    "/v1/professionals/me": {
      "post": {
        "description": "Cria o perfil, o profissional, a organização solo e o vínculo de owner, numa transação. Idempotente: chamar de novo responde o cadastro que já existe e não duplica nada. Sem `professionalType`, o cadastro é de `nutritionist`.",
        "operationId": "ProfessionalsController_register_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterProfessionalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Identidade do profissional cadastrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Corpo inválido: `api.request.invalid`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "A conta já é de um paciente: `identity.profile.not_professional`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado. É o envelope de erro de toda a API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Cadastro do profissional",
        "tags": [
          "Professionals"
        ]
      }
    },
    "/v1/invitations": {
      "post": {
        "description": "Cria o convite na organização de quem está chamando e responde o token do link, em texto puro, **uma única vez**: o banco guarda só o hash. Quem perder o link revoga o convite e cria outro. Nome e contato são opcionais, e o convite expira em 14 dias.",
        "operationId": "InvitationsController_create_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInvitationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "O convite criado e o token do link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedInvitation"
                }
              }
            }
          },
          "400": {
            "description": "Corpo inválido: `api.request.invalid`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Quem chamou não é profissional: `identity.professional.required`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Quem chamou não tem perfil: `identity.profile.not_found`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado. É o envelope de erro de toda a API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Criar um convite de paciente",
        "tags": [
          "Invitations"
        ]
      },
      "get": {
        "description": "Lista os convites da organização de quem está chamando, do mais recente para o mais antigo, com a situação de cada um. O token não vem aqui: ele é respondido só na criação.",
        "operationId": "InvitationsController_list_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Convites da organização do profissional",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationList"
                }
              }
            }
          },
          "403": {
            "description": "Quem chamou não é profissional: `identity.professional.required`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Quem chamou não tem perfil: `identity.profile.not_found`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado. É o envelope de erro de toda a API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Convites da organização",
        "tags": [
          "Invitations"
        ]
      }
    },
    "/v1/invitations/{id}/revoke": {
      "post": {
        "description": "Cancela um convite ainda pendente da organização de quem está chamando: o link para de funcionar na hora. Convite de outra organização responde 404. Convite já aceito, já revogado ou expirado responde 409 — não há o que revogar.",
        "operationId": "InvitationsController_revoke_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/InvitationId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "O convite, revogado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invitation"
                }
              }
            }
          },
          "400": {
            "description": "Id que não é um uuid: `api.request.invalid`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Quem chamou não é profissional: `identity.professional.required`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Convite que não é desta organização: `identity.invitation.not_found`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "O convite já não está pendente: `identity.invitation.not_pending`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado. É o envelope de erro de toda a API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Revogar um convite",
        "tags": [
          "Invitations"
        ]
      }
    },
    "/v1/invitations/accept": {
      "post": {
        "description": "Quem abriu o link, já autenticado no Supabase Auth, vira paciente: cria o perfil se ainda não existir, registra os consentimentos com a versão do termo, abre o vínculo com a organização do convite e marca o convite como aceito — tudo numa transação. `health_data` e `share_with_professional` são obrigatórios; `wearable_data` e `ai_processing` podem vir depois. O convite é de uso único.",
        "operationId": "InvitationsController_accept_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptInvitationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "O vínculo criado pelo aceite",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedInvitation"
                }
              }
            }
          },
          "400": {
            "description": "Corpo inválido: `api.request.invalid`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Nenhum convite com esse token: `identity.invitation.not_found`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "O convite já foi usado, foi cancelado ou expirou: `identity.invitation.already_accepted`, `identity.invitation.revoked`, `identity.invitation.expired`. Ou a conta é de um profissional: `identity.profile.not_patient`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Faltou um consentimento obrigatório: `identity.consent.required_missing`. O convite segue válido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado. É o envelope de erro de toda a API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Aceitar um convite de paciente",
        "tags": [
          "Invitations"
        ]
      }
    }
  },
  "info": {
    "title": "fit-app API",
    "description": "API da plataforma para nutricionistas esportivos.\n\nOs schemas vêm de `packages/contracts` (Zod) e são a fonte da verdade dos DTOs:\neste documento é gerado a partir deles, e o cliente de cada plataforma é gerado\na partir deste documento (`pnpm api:generate`).\n\nTodo erro responde no mesmo envelope, `{ \"error\": { \"code\", \"message\" } }`, em que\n`code` é a chave de i18n do cliente.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/SystemStatus"
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ComponentCheck"
            },
            "description": "Um resultado por componente"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "additionalProperties": false,
        "description": "Estado do processo e das suas dependências"
      },
      "SystemStatus": {
        "type": "string",
        "enum": [
          "ok",
          "degraded"
        ],
        "description": "Estado do sistema como um todo"
      },
      "ComponentCheck": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Nome do componente",
            "example": "database"
          },
          "status": {
            "$ref": "#/components/schemas/ComponentStatus"
          },
          "latencyMs": {
            "description": "Tempo de resposta do componente, em milissegundos",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name",
          "status"
        ],
        "additionalProperties": false,
        "description": "Resultado da checagem de um componente"
      },
      "ComponentStatus": {
        "type": "string",
        "enum": [
          "up",
          "down"
        ],
        "description": "Estado de um componente"
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "personId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Id da pessoa no módulo identity"
          },
          "role": {
            "$ref": "#/components/schemas/PersonRole"
          },
          "timeZone": {
            "type": "string",
            "minLength": 1,
            "description": "Fuso horário da pessoa, no formato IANA",
            "example": "America/Sao_Paulo"
          },
          "professional": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProfessionalIdentity"
              }
            ]
          }
        },
        "required": [
          "personId",
          "role",
          "timeZone"
        ],
        "additionalProperties": false,
        "description": "Identidade de quem fez a chamada"
      },
      "PersonRole": {
        "type": "string",
        "enum": [
          "professional",
          "patient"
        ],
        "description": "Papel da pessoa na plataforma"
      },
      "ProfessionalIdentity": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/ProfessionalType"
          },
          "councilNumber": {
            "type": "string",
            "minLength": 1,
            "description": "Número do registro no conselho",
            "example": "CRN-3 12345"
          },
          "specialty": {
            "description": "Especialidade declarada",
            "type": "string",
            "minLength": 1
          },
          "organizations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganizationMembership"
            },
            "description": "Organizações a que o profissional pertence"
          }
        },
        "required": [
          "type",
          "councilNumber",
          "organizations"
        ],
        "additionalProperties": false,
        "description": "Dados profissionais de quem fez a chamada"
      },
      "ProfessionalType": {
        "type": "string",
        "enum": [
          "nutritionist",
          "trainer"
        ],
        "description": "Tipo do profissional. Só o nutricionista edita plano alimentar"
      },
      "OrganizationMembership": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Id da organização"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Nome da organização",
            "example": "Ana Souza"
          },
          "kind": {
            "$ref": "#/components/schemas/OrganizationKind"
          },
          "role": {
            "$ref": "#/components/schemas/OrganizationRole"
          }
        },
        "required": [
          "organizationId",
          "name",
          "kind",
          "role"
        ],
        "additionalProperties": false,
        "description": "Vínculo da pessoa com uma organização"
      },
      "OrganizationKind": {
        "type": "string",
        "enum": [
          "solo",
          "clinic"
        ],
        "description": "Tipo da organização: consultório individual ou clínica"
      },
      "OrganizationRole": {
        "type": "string",
        "enum": [
          "owner",
          "member"
        ],
        "description": "Papel da pessoa dentro da organização"
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "description": "Corpo de erro de toda a API"
      },
      "ApiErrorDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "description": "Identificador estável do erro, usado como chave de i18n pelo cliente",
            "example": "nutrition.plan.not_found"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "Texto em pt-BR, pronto para exibir. Nunca carrega dado de paciente",
            "example": "Plano não encontrado."
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "RegisterProfessionalRequest": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "description": "Nome completo do profissional",
            "example": "Ana Souza"
          },
          "councilNumber": {
            "type": "string",
            "minLength": 3,
            "maxLength": 32,
            "description": "Número do registro no conselho",
            "example": "CRN-3 12345"
          },
          "specialty": {
            "description": "Especialidade declarada",
            "example": "Nutrição esportiva",
            "type": "string",
            "maxLength": 120
          },
          "professionalType": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProfessionalType"
              }
            ]
          }
        },
        "required": [
          "fullName",
          "councilNumber"
        ],
        "description": "Dados do primeiro acesso de um profissional"
      },
      "CreateInvitationRequest": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Como o profissional chama o paciente convidado",
            "example": "Ana",
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "contact": {
            "description": "Contato do paciente convidado",
            "example": "+55 11 90000-0000",
            "type": "string",
            "minLength": 3,
            "maxLength": 160
          }
        },
        "description": "Dados opcionais de um convite de paciente"
      },
      "CreatedInvitation": {
        "type": "object",
        "properties": {
          "invitation": {
            "$ref": "#/components/schemas/Invitation"
          },
          "token": {
            "type": "string",
            "minLength": 1,
            "description": "Token do convite, em texto puro. Respondido só aqui, na criação: o banco guarda apenas o hash. É o que vai no link enviado ao paciente"
          }
        },
        "required": [
          "invitation",
          "token"
        ],
        "additionalProperties": false,
        "description": "O convite criado e o token do link, respondido uma única vez"
      },
      "Invitation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Id do convite"
          },
          "status": {
            "$ref": "#/components/schemas/InvitationStatus"
          },
          "name": {
            "description": "Nome do paciente convidado",
            "type": "string",
            "minLength": 1
          },
          "contact": {
            "description": "Contato do paciente convidado",
            "type": "string",
            "minLength": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "Quando o convite foi criado, em UTC"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "Quando o convite expira, em UTC"
          },
          "acceptedAt": {
            "description": "Quando o convite foi aceito",
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "revokedAt": {
            "description": "Quando o convite foi revogado",
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "status",
          "createdAt",
          "expiresAt"
        ],
        "additionalProperties": false,
        "description": "Um convite de paciente"
      },
      "InvitationStatus": {
        "type": "string",
        "enum": [
          "pending",
          "accepted",
          "expired",
          "revoked"
        ],
        "description": "Situação do convite: pendente, aceito, expirado ou revogado. Derivada das datas, não guardada numa coluna"
      },
      "InvitationList": {
        "type": "object",
        "properties": {
          "invitations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Invitation"
            },
            "description": "Convites da organização, do mais recente para o mais antigo"
          }
        },
        "required": [
          "invitations"
        ],
        "additionalProperties": false,
        "description": "Convites da organização do profissional"
      },
      "InvitationId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Id do convite"
      },
      "AcceptInvitationRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 20,
            "maxLength": 200,
            "description": "Token do convite, o que vem no link"
          },
          "fullName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "description": "Nome completo do paciente",
            "example": "Ana Souza"
          },
          "timeZone": {
            "description": "Fuso horário do paciente, no formato IANA",
            "example": "America/Bahia",
            "type": "string",
            "maxLength": 64
          },
          "consents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConsentType"
            },
            "description": "Finalidades que o paciente aceitou. `health_data` e `share_with_professional` são obrigatórias; `wearable_data` e `ai_processing` são opcionais e podem ser dadas depois"
          }
        },
        "required": [
          "token",
          "fullName",
          "consents"
        ],
        "description": "Aceite de um convite por um paciente: o link, o nome e os consentimentos"
      },
      "ConsentType": {
        "type": "string",
        "enum": [
          "health_data",
          "share_with_professional",
          "wearable_data",
          "ai_processing"
        ],
        "description": "Finalidade do consentimento: dados de saúde, compartilhamento com o profissional, dados de wearable e processamento por IA. Cada uma é dada e revogada por si"
      },
      "AcceptedInvitation": {
        "type": "object",
        "properties": {
          "profileId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Id do perfil do paciente"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Id da organização que passa a acompanhar"
          },
          "careRelationshipId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Id do vínculo de acompanhamento criado"
          },
          "acceptedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "Quando o convite foi aceito, em UTC"
          },
          "consents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConsentType"
            },
            "description": "Finalidades consentidas que estão vigentes"
          }
        },
        "required": [
          "profileId",
          "organizationId",
          "careRelationshipId",
          "acceptedAt",
          "consents"
        ],
        "additionalProperties": false,
        "description": "O vínculo criado pelo aceite do convite"
      }
    }
  }
}
