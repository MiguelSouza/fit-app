# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo
# Rewritten by every `next build`, and it points at `.next/types`, which only
# exists after one. Committed, it would break `pnpm typecheck` anywhere the build
# has not run yet — starting with the CI, which checks types before building.
apps/web/next-env.d.ts

# Turborepo
.turbo/

# Tests and coverage
coverage/
*.lcov

# Environment and secrets
.env
.env.*
!.env.example

# AWS CDK
cdk.out/
.cdk.staging/

# Flutter / Dart (apps/mobile)
# The Dart client is generated from apps/api/openapi.json by `pnpm api:generate`,
# and is only usable after `dart run build_runner build` writes the built_value
# part files — which belongs to the Flutter workspace, not to this repository.
apps/mobile/packages/api_client/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
*.iml
apps/mobile/ios/Pods/
apps/mobile/android/.gradle/
apps/mobile/android/local.properties

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Synthetic patients (`pnpm seed:synthetic`): generated data, reproducible from
# its seed, and never committed.
scripts/.synthetic/
