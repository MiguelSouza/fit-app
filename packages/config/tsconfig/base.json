{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@fit-app/config - base",

  "//": "Path-independent compilerOptions only. TypeScript resolves every relative path (include, exclude, outDir, rootDir, paths) against the file that declares it, not against the file that extends it: that is why those fields are left to each workspace.",

  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "noEmit": true,
    "sourceMap": true
  }
}
