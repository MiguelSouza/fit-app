{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@fit-app/config - base",

  "//": "Somente compilerOptions independentes de caminho. O TypeScript resolve todo caminho relativo (include, exclude, outDir, rootDir, paths) contra o arquivo que o declara, nao contra quem faz o extends: por isso esses campos ficam a cargo de cada workspace.",

  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "noEmit": true,
    "sourceMap": true
  }
}
