{
  "name": "@fit-app/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Configuracao compartilhada de eslint, tsconfig e prettier",
  "exports": {
    "./eslint": "./eslint/base.js",
    "./eslint/api": "./eslint/api.js",
    "./prettier": "./prettier/index.js",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/library.json": "./tsconfig/library.json",
    "./tsconfig/nest.json": "./tsconfig/nest.json"
  },
  "scripts": {
    "build": "echo \"[@fit-app/config] nothing to build: the package ships plain config files\"",
    "dev": "echo \"[@fit-app/config] nothing to run: the package ships plain config files\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.1"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "prettier": "^3.6.0",
    "typescript": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  }
}
