{
  "name": "fit-app",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && pnpm lint:root",
    "lint:root": "eslint --no-error-on-unmatched-pattern \"*.mjs\" \"*.js\" \".archon/scripts/**/*.ts\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:archon": "bun test ./.archon/scripts/trello.test.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:generate": "pnpm --filter @fit-app/api db:generate",
    "db:migrate": "pnpm --filter @fit-app/api db:migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@fit-app/config": "workspace:*",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9",
    "supabase": "2.120.0",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  }
}
